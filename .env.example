# API server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGODB_URI=mongodb://127.0.0.1:27017/repoguideai

# Optional: increases GitHub REST API rate limit. Never put this in the client.
GITHUB_TOKEN=

# Google AI Studio Generative Language API. The server calls the configured
# model directly; access to Gemma models can vary by account and region.
AI_PROVIDER=google
GEMMA_MODEL=gemma-3-27b-it
GEMMA_API_KEY=

# Optional local OpenAI-compatible inference endpoint instead of hosted Gemma.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:1234/v1
# AI_API_KEY=
# AI_MODEL=gemma-3-4b-it
